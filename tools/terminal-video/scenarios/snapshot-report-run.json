  {
   "type": "wait",
   "dur": 3200,
   "cap": "3. It reads vCenter and writes the CSV - read-only, nothing is changed"
  },
  {
   "type": "prompt",
   "cap": "4. Open the report"
  },
  {
   "type": "wait",
   "dur": 700
  },
  {
   "type": "type",
